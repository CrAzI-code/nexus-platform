generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum OrganizationStatus {
  ACTIVE
  ARCHIVED
}

enum OrganizationRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
}

enum InvitationRole {
  ADMIN
  MANAGER
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum ProjectMemberStatus {
  ACTIVE
  REMOVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum FileScanStatus {
  CLEAN
  UNSCANNED
}

enum TaskActivityType {
  CREATED
  UPDATED
  STATUS_CHANGED
  BLOCKER_CREATED
  BLOCKER_RESOLVED
  ASSIGNEE_CHANGED
  COMMENT_ADDED
  ARCHIVED
  RESTORED
  AUTOMATION
}

enum WorkflowAutomationTrigger {
  TASK_CREATED
  TASK_STATUS_CHANGED
  TASK_ASSIGNED
  TASK_DUE_DATE_APPROACHING
  TASK_OVERDUE
  TASK_BLOCKER_REPORTED
  TASK_BLOCKER_RESOLVED
}

enum WorkflowAutomationAction {
  SEND_NOTIFICATION
  CHANGE_STATUS
  ASSIGN_MEMBER
}

enum WorkflowAutomationExecutionStatus {
  RUNNING
  SUCCEEDED
  SKIPPED
  FAILED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
  DECLINED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_COMMENT
  TASK_MENTION
  TASK_STATUS_CHANGED
  TASK_BLOCKED
  TASK_UNBLOCKED
  TASK_DUE_DATE
  TASK_OVERDUE
  PROJECT_ADDED
  PROJECT_UPDATED
  ORGANIZATION_INVITATION
  TEAM_UPDATED
  PROJECT_DISCUSSION_MESSAGE
  WORKFLOW_AUTOMATION
}

enum NotificationResourceType {
  TASK
  PROJECT
  ORGANIZATION_INVITATION
  ORGANIZATION
}

enum AuditLogAction {
  ORGANIZATION_MEMBER_ROLE_CHANGED
  ORGANIZATION_MEMBER_REMOVED
  INVITATION_CREATED
  INVITATION_REVOKED
  INVITATION_ACCEPTED
  INVITATION_RESENT
  INVITATION_DECLINED
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_ARCHIVED
  PROJECT_RESTORED
  PROJECT_MEMBER_ADDED
  PROJECT_MEMBER_REMOVED
  TASK_ASSIGNED
  TASK_UPDATED
  TASK_STATUS_CHANGED
  TASK_BLOCKED
  TASK_UNBLOCKED
  TASK_ARCHIVED
  TASK_RESTORED
  FILE_UPLOADED
  FILE_REMOVED
}

enum AuditLogTargetType {
  ORGANIZATION_MEMBER
  INVITATION
  PROJECT
  PROJECT_MEMBER
  TASK
  FILE_ATTACHMENT
}

model User {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  email     String
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  identities       AuthIdentity[]
  memberships      OrganizationMembership[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  blockersCreated  TaskBlocker[]            @relation("TaskBlockerCreator")
  blockersResolved TaskBlocker[]            @relation("TaskBlockerResolver")
  projectDiscussionsCreated ProjectDiscussion[]        @relation("ProjectDiscussionCreator")
  projectDiscussionMessages ProjectDiscussionMessage[]  @relation("ProjectDiscussionMessageAuthor")
  projectDiscussionReads    ProjectDiscussionRead[]
  workflowAutomationsCreated WorkflowAutomation[] @relation("WorkflowAutomationCreator")

  @@map("users")
}

model AuthIdentity {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  provider        String
  providerSubject String   @map("provider_subject")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, providerSubject])
  @@unique([userId, provider])
  @@map("auth_identities")
}

model Organization {
  id        String             @id @default(uuid()) @db.Uuid
  name      String
  slug      String             @unique
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  memberships   OrganizationMembership[]
  projects      Project[]
  invitations   Invitation[]
  notifications Notification[]
  auditLogs     AuditLog[]

  @@map("organizations")
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  role           OrganizationRole @default(MEMBER)
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  projectMemberships ProjectMember[]
  sentInvitations    Invitation[]     @relation("InvitationInviterMembership")
  uploadedFiles      FileAttachment[] @relation("FileUploaderMembership")

  @@unique([organizationId, userId])
  @@unique([organizationId], where: { role: "OWNER", status: "ACTIVE" }, map: "organization_memberships_one_active_owner")
  @@index([userId, status])
  @@map("organization_memberships")
}

model Project {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  name           String
  description    String?
  status         ProjectStatus @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  members       ProjectMember[]
  tasks         Task[]
  notifications Notification[]
  files         FileAttachment[]
  discussions   ProjectDiscussion[]
  automations   WorkflowAutomation[]

  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@map("projects")
}

model ProjectMember {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  projectId      String              @map("project_id") @db.Uuid
  userId         String              @map("user_id") @db.Uuid
  status         ProjectMemberStatus @default(ACTIVE)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  project    Project                @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict)
  membership OrganizationMembership @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Restrict)

  assignedTasks  Task[]         @relation("TaskAssignee")
  createdTasks   Task[]         @relation("TaskCreator")
  comments       TaskComment[]  @relation("TaskCommentAuthor")
  taskActivities TaskActivity[] @relation("TaskActivityActor")
  workflowConditions WorkflowAutomation[] @relation("WorkflowAutomationConditionAssignee")
  workflowAssignments WorkflowAutomation[] @relation("WorkflowAutomationActionAssignee")
  @@unique([organizationId, projectId, userId])
  @@index([organizationId, userId, status])
  @@map("project_members")
}

model Task {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  projectId      String       @map("project_id") @db.Uuid
  creatorId      String       @map("creator_id") @db.Uuid
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  assigneeId     String?      @map("assignee_id") @db.Uuid
  dueAt          DateTime?    @map("due_at") @db.Timestamptz
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  project Project @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict)

  creator ProjectMember @relation("TaskCreator", fields: [organizationId, projectId, creatorId], references: [organizationId, projectId, userId], onDelete: Restrict)

  assignee        ProjectMember?       @relation("TaskAssignee", fields: [organizationId, projectId, assigneeId], references: [organizationId, projectId, userId], onDelete: Restrict)
  comments        TaskComment[]
  activities      TaskActivity[]
  blockers        TaskBlocker[]
  fileAttachments TaskFileAttachment[]
  automationExecutions WorkflowAutomationExecution[]

  @@unique([organizationId, projectId, id])
  @@index([organizationId, projectId, status])
  @@index([dueAt, id], map: "tasks_due_at_id_idx")
  @@index([organizationId, assigneeId, status])
  @@index([organizationId, projectId, creatorId])
  @@map("tasks")
}

model TaskComment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  taskId         String   @map("task_id") @db.Uuid
  authorId       String   @map("author_id") @db.Uuid
  body           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  task   Task          @relation(fields: [organizationId, projectId, taskId], references: [organizationId, projectId, id], onDelete: Restrict)
  author ProjectMember @relation("TaskCommentAuthor", fields: [organizationId, projectId, authorId], references: [organizationId, projectId, userId], onDelete: Restrict)

  @@index([organizationId, projectId, taskId, createdAt])
  @@map("task_comments")
}

model TaskActivity {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  projectId      String           @map("project_id") @db.Uuid
  taskId         String           @map("task_id") @db.Uuid
  actorId        String           @map("actor_id") @db.Uuid
  type           TaskActivityType
  message        String
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz

  task  Task          @relation(fields: [organizationId, projectId, taskId], references: [organizationId, projectId, id], onDelete: Restrict)
  actor ProjectMember @relation("TaskActivityActor", fields: [organizationId, projectId, actorId], references: [organizationId, projectId, userId], onDelete: Restrict)
  automationExecutions WorkflowAutomationExecution[] @relation("WorkflowAutomationSourceActivity")

  @@index([organizationId, projectId, taskId, createdAt])
  @@map("task_activities")
}

model WorkflowAutomation {
  id                    String                      @id @default(uuid()) @db.Uuid
  organizationId        String                      @map("organization_id") @db.Uuid
  projectId             String                      @map("project_id") @db.Uuid
  createdById            String                      @map("created_by_id") @db.Uuid
  name                   String                      @db.VarChar(120)
  trigger                WorkflowAutomationTrigger
  conditionPriority      TaskPriority?               @map("condition_priority")
  conditionStatus        TaskStatus?                 @map("condition_status")
  conditionAssigneeId    String?                     @map("condition_assignee_id") @db.Uuid
  action                 WorkflowAutomationAction
  actionValue            String?                     @map("action_value") @db.VarChar(500)
  actionAssigneeId       String?                     @map("action_assignee_id") @db.Uuid
  enabled                Boolean                     @default(true)
  deletedAt              DateTime?                   @map("deleted_at") @db.Timestamptz(3)
  createdAt              DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)

  project             Project         @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict, map: "workflow_automations_project_fkey")
  creator             User            @relation("WorkflowAutomationCreator", fields: [createdById], references: [id], onDelete: Restrict, map: "workflow_automations_creator_fkey")
  conditionAssignee   ProjectMember?  @relation("WorkflowAutomationConditionAssignee", fields: [organizationId, projectId, conditionAssigneeId], references: [organizationId, projectId, userId], onDelete: Restrict, map: "workflow_automations_condition_assignee_fkey")
  actionAssignee      ProjectMember?  @relation("WorkflowAutomationActionAssignee", fields: [organizationId, projectId, actionAssigneeId], references: [organizationId, projectId, userId], onDelete: Restrict, map: "workflow_automations_action_assignee_fkey")
  executions          WorkflowAutomationExecution[]

  @@unique([organizationId, projectId, id])
  @@index([organizationId, projectId, enabled, trigger], map: "workflow_automations_organization_id_project_id_enabled_trigger")
  @@map("workflow_automations")
}

model WorkflowAutomationExecution {
  id              String                            @id @default(uuid()) @db.Uuid
  organizationId  String                            @map("organization_id") @db.Uuid
  projectId       String                            @map("project_id") @db.Uuid
  ruleId          String                            @map("rule_id") @db.Uuid
  taskId          String                            @map("task_id") @db.Uuid
  sourceActivityId String?                           @map("source_activity_id") @db.Uuid
  eventKey        String                            @map("event_key") @db.VarChar(200)
  trigger         WorkflowAutomationTrigger
  status          WorkflowAutomationExecutionStatus @default(RUNNING)
  reason          String?                           @db.VarChar(500)
  error           String?                           @db.Text
  attempt         Int                               @default(1)
  triggeredAt     DateTime                          @default(now()) @map("triggered_at") @db.Timestamptz(3)
  completedAt     DateTime?                         @map("completed_at") @db.Timestamptz(3)

  rule          WorkflowAutomation @relation(fields: [organizationId, projectId, ruleId], references: [organizationId, projectId, id], onDelete: Restrict, map: "workflow_automation_executions_rule_fkey")
  task          Task               @relation(fields: [organizationId, projectId, taskId], references: [organizationId, projectId, id], onDelete: Restrict, map: "workflow_automation_executions_task_fkey")
  sourceActivity TaskActivity?     @relation("WorkflowAutomationSourceActivity", fields: [sourceActivityId], references: [id], onDelete: Restrict, map: "workflow_automation_executions_source_activity_fkey")

  @@unique([ruleId, eventKey])
  @@index([organizationId, projectId, triggeredAt(sort: Desc)], map: "workflow_automation_executions_organization_id_project_id_trigg")
  @@index([status, attempt, triggeredAt])
  @@map("workflow_automation_executions")
}

model ProjectDiscussion {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  createdById    String   @map("created_by_id") @db.Uuid
  title          String   @db.VarChar(160)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  project    Project                     @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict)
  creator    User                        @relation("ProjectDiscussionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  messages   ProjectDiscussionMessage[]
  readStates ProjectDiscussionRead[]

  @@unique([organizationId, projectId, id])
  @@index([organizationId, projectId, createdAt, id], map: "project_discussions_organization_id_project_id_created_at_id_id")
  @@map("project_discussions")
}

model ProjectDiscussionMessage {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  projectId      String    @map("project_id") @db.Uuid
  discussionId   String    @map("discussion_id") @db.Uuid
  authorId       String    @map("author_id") @db.Uuid
  body           String    @db.VarChar(5000)
  editedAt       DateTime? @map("edited_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  discussion ProjectDiscussion @relation(fields: [organizationId, projectId, discussionId], references: [organizationId, projectId, id], onDelete: Restrict, map: "project_discussion_messages_organization_id_project_id_discussi")
  author     User              @relation("ProjectDiscussionMessageAuthor", fields: [authorId], references: [id], onDelete: Restrict, map: "project_discussion_messages_author_id_fkey")

  @@unique([organizationId, projectId, discussionId, id], map: "project_discussion_messages_scope_id_key")
  @@index([organizationId, projectId, discussionId, createdAt, id], map: "project_discussion_messages_cursor_idx")
  @@map("project_discussion_messages")
}

model ProjectDiscussionRead {
  organizationId    String    @map("organization_id") @db.Uuid
  projectId         String    @map("project_id") @db.Uuid
  discussionId      String    @map("discussion_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  lastReadAt        DateTime? @map("last_read_at") @db.Timestamptz(3)
  lastReadMessageId String?   @map("last_read_message_id") @db.Uuid
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  discussion ProjectDiscussion @relation(fields: [organizationId, projectId, discussionId], references: [organizationId, projectId, id], onDelete: Restrict, map: "project_discussion_reads_organization_id_project_id_discussion_")
  user       User              @relation(fields: [userId], references: [id], onDelete: Restrict, map: "project_discussion_reads_user_id_fkey")

  @@id([organizationId, projectId, discussionId, userId])
  @@index([organizationId, projectId, userId])
  @@map("project_discussion_reads")
}

model TaskBlocker {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  projectId      String     @map("project_id") @db.Uuid
  taskId         String     @map("task_id") @db.Uuid
  reason         String     @db.VarChar(2000)
  priorStatus    TaskStatus @map("prior_status")
  createdById    String     @map("created_by_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz
  resolvedById   String?    @map("resolved_by_id") @db.Uuid
  resolvedAt     DateTime?  @map("resolved_at") @db.Timestamptz

  task     Task  @relation(fields: [organizationId, projectId, taskId], references: [organizationId, projectId, id], onDelete: Restrict)
  creator  User  @relation("TaskBlockerCreator", fields: [createdById], references: [id], onDelete: Restrict)
  resolver User? @relation("TaskBlockerResolver", fields: [resolvedById], references: [id], onDelete: Restrict)

  @@unique([organizationId, projectId, taskId], where: { resolvedAt: null }, map: "task_blockers_one_active_per_task")
  @@index([organizationId, projectId, taskId, createdAt], map: "task_blockers_organization_id_project_id_task_id_created_at_idx")
  @@index([organizationId, projectId, taskId, resolvedAt], map: "task_blockers_organization_id_project_id_task_id_resolved_at_id")
  @@map("task_blockers")
}

model FileAttachment {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  projectId      String         @map("project_id") @db.Uuid
  uploadedById   String         @map("uploaded_by_id") @db.Uuid
  storageKey     String         @unique @map("storage_key") @db.VarChar(36)
  originalName   String         @map("original_name") @db.VarChar(255)
  mimeType       String         @map("mime_type") @db.VarChar(100)
  sizeBytes      Int            @map("size_bytes")
  scanStatus     FileScanStatus @default(UNSCANNED) @map("scan_status")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  removedAt      DateTime?      @map("removed_at") @db.Timestamptz

  project            Project                @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict)
  uploaderMembership OrganizationMembership @relation("FileUploaderMembership", fields: [organizationId, uploadedById], references: [organizationId, userId], onDelete: Restrict)
  taskAttachment     TaskFileAttachment?

  @@unique([organizationId, projectId, id])
  @@index([organizationId, projectId, removedAt, createdAt(sort: Desc)], map: "file_attachments_organization_id_project_id_removed_at_created_")
  @@map("file_attachments")
}

model TaskFileAttachment {
  organizationId String @map("organization_id") @db.Uuid
  projectId      String @map("project_id") @db.Uuid
  taskId         String @map("task_id") @db.Uuid
  fileId         String @map("file_id") @db.Uuid

  task Task           @relation(fields: [organizationId, projectId, taskId], references: [organizationId, projectId, id], onDelete: Restrict)
  file FileAttachment @relation(fields: [organizationId, projectId, fileId], references: [organizationId, projectId, id], onDelete: Restrict)

  @@id([organizationId, projectId, fileId])
  @@index([organizationId, projectId, taskId])
  @@map("task_file_attachments")
}

model Invitation {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  inviterId      String           @map("inviter_id") @db.Uuid
  email          String
  intendedRole   InvitationRole   @default(MEMBER) @map("intended_role")
  status         InvitationStatus @default(PENDING)
  tokenHash      String           @unique @map("token_hash")
  expiresAt      DateTime         @map("expires_at") @db.Timestamptz
  acceptedAt     DateTime?        @map("accepted_at") @db.Timestamptz
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  inviterMembership OrganizationMembership @relation("InvitationInviterMembership", fields: [organizationId, inviterId], references: [organizationId, userId], onDelete: Restrict)

  @@index([organizationId, status])
  @@map("invitations")
}

model Notification {
  id             String                   @id @default(uuid()) @db.Uuid
  recipientId    String                   @map("recipient_id") @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  projectId      String?                  @map("project_id") @db.Uuid
  type           NotificationType
  title          String                   @db.VarChar(200)
  message        String                   @db.VarChar(1000)
  resourceType   NotificationResourceType @map("resource_type")
  resourceId     String                   @map("resource_id") @db.Uuid
  eventKey       String                   @map("event_key") @db.VarChar(160)
  readAt         DateTime?                @map("read_at") @db.Timestamptz
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)

  recipient    User         @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project      Project?     @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict)

  @@unique([recipientId, eventKey])
  @@index([recipientId, createdAt, id])
  @@index([recipientId, readAt, createdAt])
  @@index([organizationId, recipientId])
  @@index([projectId])
  @@map("notifications")
}

model AuditLog {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  actorId        String             @map("actor_id") @db.Uuid
  action         AuditLogAction
  targetType     AuditLogTargetType @map("target_type")
  targetId       String             @map("target_id") @db.Uuid
  before         Json?              @db.JsonB
  after          Json?              @db.JsonB
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User         @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([organizationId, action, createdAt(sort: Desc)])
  @@index([organizationId, actorId, createdAt(sort: Desc)])
  @@index([organizationId, targetType, targetId, createdAt(sort: Desc)])
  @@map("audit_logs")
}
