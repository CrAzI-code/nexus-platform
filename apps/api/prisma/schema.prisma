generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum OrganizationStatus {
  ACTIVE
  ARCHIVED
}

enum OrganizationRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
}

enum InvitationRole {
  ADMIN
  MANAGER
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum ProjectMemberStatus {
  ACTIVE
  REMOVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskActivityType {
  CREATED
  UPDATED
  STATUS_CHANGED
  ASSIGNEE_CHANGED
  COMMENT_ADDED
  ARCHIVED
  RESTORED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_COMMENT
  TASK_MENTION
  TASK_STATUS_CHANGED
  PROJECT_ADDED
  PROJECT_UPDATED
  ORGANIZATION_INVITATION
  TEAM_UPDATED
}

enum NotificationResourceType {
  TASK
  PROJECT
  ORGANIZATION_INVITATION
  ORGANIZATION
}

model User {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  email     String
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  identities  AuthIdentity[]
  memberships OrganizationMembership[]
  notifications Notification[]

  @@map("users")
}

model AuthIdentity {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  provider        String
  providerSubject String   @map("provider_subject")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, providerSubject])
  @@unique([userId, provider])
  @@map("auth_identities")
}

model Organization {
  id        String             @id @default(uuid()) @db.Uuid
  name      String
  slug      String             @unique
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  memberships OrganizationMembership[]
  projects    Project[]
  invitations Invitation[]
  notifications Notification[]

  @@map("organizations")
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  role           OrganizationRole @default(MEMBER)
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  projectMemberships ProjectMember[]
  sentInvitations    Invitation[]    @relation("InvitationInviterMembership")

  @@unique([organizationId, userId])
  @@unique([organizationId], where: { role: "OWNER", status: "ACTIVE" }, map: "organization_memberships_one_active_owner")
  @@index([userId, status])
  @@map("organization_memberships")
}

model Project {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  name           String
  description    String?
  status         ProjectStatus @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  members ProjectMember[]
  tasks   Task[]
  notifications Notification[]

  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@map("projects")
}

model ProjectMember {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  projectId      String              @map("project_id") @db.Uuid
  userId         String              @map("user_id") @db.Uuid
  status         ProjectMemberStatus @default(ACTIVE)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  project    Project                @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict)
  membership OrganizationMembership @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Restrict)

  assignedTasks  Task[]         @relation("TaskAssignee")
  createdTasks   Task[]         @relation("TaskCreator")
  comments       TaskComment[]  @relation("TaskCommentAuthor")
  taskActivities TaskActivity[] @relation("TaskActivityActor")

  @@unique([organizationId, projectId, userId])
  @@index([organizationId, userId, status])
  @@map("project_members")
}

model Task {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  projectId      String       @map("project_id") @db.Uuid
  creatorId      String       @map("creator_id") @db.Uuid
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  assigneeId     String?      @map("assignee_id") @db.Uuid
  dueAt          DateTime?    @map("due_at") @db.Timestamptz
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  project Project @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict)

  creator ProjectMember @relation("TaskCreator", fields: [organizationId, projectId, creatorId], references: [organizationId, projectId, userId], onDelete: Restrict)

  assignee   ProjectMember? @relation("TaskAssignee", fields: [organizationId, projectId, assigneeId], references: [organizationId, projectId, userId], onDelete: Restrict)
  comments   TaskComment[]
  activities TaskActivity[]

  @@unique([organizationId, projectId, id])
  @@index([organizationId, projectId, status])
  @@index([organizationId, assigneeId, status])
  @@index([organizationId, projectId, creatorId])
  @@map("tasks")
}

model TaskComment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  taskId         String   @map("task_id") @db.Uuid
  authorId       String   @map("author_id") @db.Uuid
  body           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  task   Task          @relation(fields: [organizationId, projectId, taskId], references: [organizationId, projectId, id], onDelete: Restrict)
  author ProjectMember @relation("TaskCommentAuthor", fields: [organizationId, projectId, authorId], references: [organizationId, projectId, userId], onDelete: Restrict)

  @@index([organizationId, projectId, taskId, createdAt])
  @@map("task_comments")
}

model TaskActivity {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  projectId      String           @map("project_id") @db.Uuid
  taskId         String           @map("task_id") @db.Uuid
  actorId        String           @map("actor_id") @db.Uuid
  type           TaskActivityType
  message        String
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz

  task  Task          @relation(fields: [organizationId, projectId, taskId], references: [organizationId, projectId, id], onDelete: Restrict)
  actor ProjectMember @relation("TaskActivityActor", fields: [organizationId, projectId, actorId], references: [organizationId, projectId, userId], onDelete: Restrict)

  @@index([organizationId, projectId, taskId, createdAt])
  @@map("task_activities")
}

model Invitation {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  inviterId      String           @map("inviter_id") @db.Uuid
  email          String
  intendedRole   InvitationRole   @default(MEMBER) @map("intended_role")
  status         InvitationStatus @default(PENDING)
  tokenHash      String           @unique @map("token_hash")
  expiresAt      DateTime         @map("expires_at") @db.Timestamptz
  acceptedAt     DateTime?        @map("accepted_at") @db.Timestamptz
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  inviterMembership OrganizationMembership @relation("InvitationInviterMembership", fields: [organizationId, inviterId], references: [organizationId, userId], onDelete: Restrict)

  @@index([organizationId, status])
  @@map("invitations")
}

model Notification {
  id             String                   @id @default(uuid()) @db.Uuid
  recipientId    String                   @map("recipient_id") @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  projectId      String?                  @map("project_id") @db.Uuid
  type           NotificationType
  title          String                   @db.VarChar(200)
  message        String                   @db.VarChar(1000)
  resourceType   NotificationResourceType @map("resource_type")
  resourceId     String                   @map("resource_id") @db.Uuid
  eventKey       String                   @map("event_key") @db.VarChar(160)
  readAt         DateTime?                @map("read_at") @db.Timestamptz
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz

  recipient   User         @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project     Project?      @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict)

  @@unique([recipientId, eventKey])
  @@index([recipientId, createdAt, id])
  @@index([recipientId, readAt, createdAt])
  @@index([organizationId, recipientId])
  @@index([projectId])
  @@map("notifications")
}
