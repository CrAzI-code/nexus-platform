
# Application environment
NODE_ENV=development

# Frontend
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000

# Backend
API_PORT=4000

# Private file storage for the API (path relative to apps/api)
FILE_STORAGE_PATH=./private-files
FILE_MAX_UPLOAD_BYTES=10485760

# Brevo transactional email (copy these settings to apps/api/.env)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=NEXUS

# Database
DATABASE_URL=postgresql://nexus_user:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/nexus_dev
