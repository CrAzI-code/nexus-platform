
# Application environment
NODE_ENV=development

# Frontend
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000

# Backend
API_PORT=4000

# Private file storage for the API (path relative to apps/api)
FILE_STORAGE_DRIVER=local
FILE_STORAGE_PATH=./private-files
FILE_MAX_UPLOAD_BYTES=10485760
FILE_ORPHAN_MIN_AGE_SECONDS=86400

# Private S3-compatible storage (required when FILE_STORAGE_DRIVER=s3)
# The AWS SDK uses AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY and optional
# AWS_SESSION_TOKEN from the standard provider chain. Keep the bucket private.
FILE_S3_BUCKET=
FILE_S3_REGION=
FILE_S3_PREFIX=nexus
FILE_S3_ENDPOINT=
FILE_S3_FORCE_PATH_STYLE=false

# Local RustFS credentials. Replace both values before starting Docker services.
# These placeholders are for local development only and are not production secrets.
RUSTFS_ACCESS_KEY=replace_with_unique_local_access_key
RUSTFS_SECRET_KEY=replace_with_unique_local_secret_key_at_least_32_chars

# Use the same values for the API's AWS SDK when enabling RustFS storage.
AWS_ACCESS_KEY_ID=replace_with_unique_local_access_key
AWS_SECRET_ACCESS_KEY=replace_with_unique_local_secret_key_at_least_32_chars

# Malware scanning is mandatory in every environment; local uploads use ClamAV.
# The optional HTTP scanner accepts file bytes via POST and returns
# {"status":"clean"|"infected"}.
FILE_MALWARE_SCAN_REQUIRED=true
FILE_MALWARE_SCANNER_DRIVER=clamav
FILE_MALWARE_SCANNER_URL=
FILE_MALWARE_SCANNER_TOKEN=
FILE_MALWARE_SCANNER_TIMEOUT_MS=10000
FILE_MALWARE_SCANNER_HOST=127.0.0.1
FILE_MALWARE_SCANNER_PORT=3310

# Brevo transactional email (copy these settings to apps/api/.env)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=NEXUS

# Database
DATABASE_URL=postgresql://nexus:nexus_local_dev@localhost:5432/nexus
